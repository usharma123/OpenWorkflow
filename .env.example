# Browser-visible Vite settings. These are identifiers, not secrets.
VITE_CONVEX_URL=
VITE_CLERK_PUBLISHABLE_KEY=

# Set the following on each Convex deployment with `bunx convex env set`.
# Do not prefix server-only values with VITE_ and do not commit real values.
CLERK_JWT_ISSUER_DOMAIN=https://your-instance.clerk.accounts.dev
CLERK_SECRET_KEY=
APP_URL=http://localhost:5173

OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=OpenWorkflow

# Required only for Code, Shell, and Git steps inside a Daytona sandbox boundary.
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=us

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_OAUTH_REDIRECT_URI=https://your-deployment.convex.site/oauth/slack/callback

# Base64 encoding of exactly 32 random bytes. Generate once per environment.
CONNECTION_ENCRYPTION_KEY=
