# Created by `npx convex dev`.
VITE_CONVEX_URL=

# Server-side Convex environment variable. Set with:
# npx convex env set OPENROUTER_API_KEY sk-or-v1-...
OPENROUTER_API_KEY=

# Optional metadata shown by OpenRouter rankings.
OPENROUTER_SITE_URL=https://your-app.vercel.app
OPENROUTER_APP_NAME=OpenWorkflow

# POC connector bootstrap. Set these with `bunx convex env set`; never expose
# them as VITE_ variables. Use short-lived tokens with only the scopes in README.
GOOGLE_WORKSPACE_CONNECTION_REF=google-workspace-poc
GOOGLE_WORKSPACE_ACCESS_TOKEN=
SLACK_CONNECTION_REF=slack-poc
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
